FROM container-registry.oracle.com/java/openjdk:25

ENV LANGUAGE='pt_BR:pt'
ENV TZ='America/Sao_Paulo'

WORKDIR /deployments

COPY --chown=1001:1001 build/quarkus-app/lib/ /deployments/lib/
COPY --chown=1001:1001 build/quarkus-app/*.jar /deployments/
COPY --chown=1001:1001 build/quarkus-app/app/ /deployments/app/
COPY --chown=1001:1001 build/quarkus-app/quarkus/ /deployments/quarkus/

RUN chmod -R 755 /deployments

EXPOSE 8085
USER 1001

ENTRYPOINT [ "java", "-Duser.timezone=America/Sao_Paulo", "-Dquarkus.http.host=0.0.0.0", "-Djava.util.logging.manager=org.jboss.logmanager.LogManager", "-jar", "/deployments/quarkus-run.jar" ]
